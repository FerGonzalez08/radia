# URLs base de los 4 microservicios reales de RADIA (services/*-service del
# repo de backend). En local, con `docker compose up` desde la raíz de ese
# repo, quedan expuestos en estos puertos (ver docker-compose.yml).
VITE_API_URL=http://localhost:8001
VITE_ROLE_API_URL=http://localhost:8002
VITE_NAV_API_URL=http://localhost:8003
VITE_CHAT_API_URL=http://localhost:8004

# Agente de orientación académica (IA) — repo MiguelRamos00/Proyecto-de-grado,
# rama feat/integracion-radia. Se levanta con su propio `docker compose up`.
VITE_AGENTE_ORIENTACION_API_URL=http://localhost:8000
