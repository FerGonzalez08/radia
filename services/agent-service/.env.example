# Agente de orientación académica (IA) — origen: repo MiguelRamos00/Proyecto-de-grado
# (carpeta backend/, rama feat/integracion-radia). En docker compose queda en el puerto 8005.

# La base de datos la crea el contenedor agent-db con estas mismas credenciales
# (ver docker-compose.yml). Si cambias la contraseña, cámbiala en ambos lugares.
DATABASE_URL=postgresql+psycopg://agent_user:agent_pass@agent-db:5432/agent_db

# Proveedor de IA: simulado | gemini | openai | openrouter
# "simulado" responde frases fijas por palabra clave (solo para probar la conexión).
PROVEEDOR_IA=simulado
MODELO_IA=gemini-2.5-flash
CLAVE_API_IA=
URL_BASE_IA=
TEMPERATURA_IA=0.2

# File Search documental de Gemini (opcional)
USAR_FILE_SEARCH=false
ALMACEN_FILE_SEARCH=
MODELO_FILE_SEARCH=

# Orígenes que pueden llamar al agente desde el navegador (frontend de RADIA).
ORIGENES_CORS=http://localhost:5173
